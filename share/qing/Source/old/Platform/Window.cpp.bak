#include <windows.h>
#include <windowsx.h>
#include "qingWindow.h"
#include "../Core/qingPetState.h"

// =======================
// 外部状态（来自 Core）
// =======================
extern QingPetState g_pet;

// =======================
// HitTest：判断是否在宠物区域
// =======================
bool IsInsidePet(int x, int y)
{
    return x >= g_pet.x &&
           x <= g_pet.x + g_pet.w &&
           y >= g_pet.y &&
           y <= g_pet.y + g_pet.h;
}

// =======================
// 窗口过程
// =======================
LRESULT CALLBACK QingWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
{
    switch (msg)
    {
    case WM_MOUSEMOVE:
    {
        int x = GET_X_LPARAM(lParam);
        int y = GET_Y_LPARAM(lParam);

        if (IsInsidePet(x, y))
        {
            // 进入宠物区域 → 允许接收输入
            SetWindowLong(hwnd, GWL_EXSTYLE,
                GetWindowLong(hwnd, GWL_EXSTYLE) & ~WS_EX_TRANSPARENT);
        }
        else
        {
            // 离开宠物区域 → 点击穿透
            SetWindowLong(hwnd, GWL_EXSTYLE,
                GetWindowLong(hwnd, GWL_EXSTYLE) | WS_EX_TRANSPARENT);
        }

        break;
    }

    case WM_LBUTTONDOWN:
    {
        int x = GET_X_LPARAM(lParam);
        int y = GET_Y_LPARAM(lParam);

        if (IsInsidePet(x, y))
        {
            // 在宠物上点击（这里以后可以接入 InputDispatcher）
            // 暂时先用于拖动逻辑
            g_pet.isDragging = true;
            g_pet.dragOffsetX = x - g_pet.x;
            g_pet.dragOffsetY = y - g_pet.y;
        }

        break;
    }

    case WM_MOUSEMOVE:
    {
        int x = GET_X_LPARAM(lParam);
        int y = GET_Y_LPARAM(lParam);

        if (g_pet.isDragging)
        {
            g_pet.x = x - g_pet.dragOffsetX;
            g_pet.y = y - g_pet.dragOffsetY;
        }

        break;
    }

    case WM_LBUTTONUP:
    {
        g_pet.isDragging = false;
        break;
    }

    case WM_PAINT:
    {
        // 这里暂时留空（Render模块会接管）